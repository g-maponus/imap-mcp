<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent: keeps imap-mcp running (remote/http mode) while you are logged in.
     Replace every __PLACEHOLDER__, copy to ~/Library/LaunchAgents/, then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/co.imap-mcp.plist   -->
<plist version="1.0">
<dict>
  <key>Label</key><string>co.imap-mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>__REPO__/app/server.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>IMAP_MCP_TRANSPORT</key><string>http</string>
    <key>IMAP_MCP_BASE_URL</key><string>https://__MACHINE__.__TAILNET__.ts.net</string>
    <key>IMAP_MCP_GITHUB_CLIENT_ID</key><string>__GITHUB_CLIENT_ID__</string>
    <key>IMAP_MCP_ALLOWED_GITHUB_LOGINS</key><string>__YOUR_GITHUB_LOGIN__</string>
    <key>IMAP_MCP_PORT</key><string>8770</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/imap-mcp.log</string>
  <key>StandardErrorPath</key><string>/tmp/imap-mcp.log</string>
</dict>
</plist>
